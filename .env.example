# Copy this file to .env and fill in real values. .env is git-ignored.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=RentalAppDb

# Long random string in real environments (this is a dev-only placeholder)
JWT_KEY=dev-only-local-secret-please-change-32chars-min
JWT_ISSUER=RentalApp
JWT_AUDIENCE=RentalAppClients
JWT_EXPIRES_MINUTES=120

# Must be exactly 32 characters (AES-256)
CRYPTO_AES_KEY=CHANGE_ME_32_CHAR_AES_KEY_VALUE!
